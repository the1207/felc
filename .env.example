# Configuration Base de données PostgreSQL (Neon / Supabase / Local)
DB_URL=jdbc:postgresql://<hote>/<base>?sslmode=require
DB_USER=<utilisateur>
DB_PASSWORD=<mot_de_passe>

# Sécurité & JWT (Clé secrète d'au moins 32 caractères pour HS256)
JWT_SECRET=super-secret-key-felc-hackathon-2026-minimum-32-chars

# IA & Correction automatique
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
GITHUB_TOKEN=ghp_...

# Administrateur initial (AdminInitializer)
ADMIN_EMAIL=admin@felc.com
ADMIN_PASSWORD=admin-password-secret-123


